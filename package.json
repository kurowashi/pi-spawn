{
	"name": "pi-spawn",
	"version": "0.0.0",
	"private": true,
	"description": "Spawn Pi child agent sessions and let sibling agents message each other in-process",
	"keywords": ["pi-package", "pi", "agent", "spawn", "delegation"],
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"pi": {
		"extensions": ["./src/index.ts"]
	},
	"files": ["src"],
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-agent-core": { "optional": true },
		"@earendil-works/pi-ai": { "optional": true },
		"@earendil-works/pi-coding-agent": { "optional": true },
		"typebox": { "optional": true }
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@earendil-works/pi-agent-core": "0.87.1",
		"@earendil-works/pi-ai": "0.87.1",
		"@earendil-works/pi-coding-agent": "0.87.1",
		"@types/node": "^24.0.0",
		"lefthook": "2.1.14",
		"typebox": "1.3.34",
		"typescript": "7.0.2"
	},
	"scripts": {
		"check": "biome check . && tsc --noEmit",
		"fix": "biome check --write .",
		"test": "node --test \"test/**/*.test.ts\"",
		"test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=80 --test-coverage-functions=80 \"test/unit/**/*.test.ts\" \"test/integration/**/*.test.ts\"",
		"verify": "npm run check && npm test && npm run test:coverage"
	}
}
